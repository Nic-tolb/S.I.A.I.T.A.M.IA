    {
      "id": "8a1f0c52-1d0e-4c1a-9b11-000000000004",
      "name": "Prepare articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Splits the request into articles to upsert (active) and ids to delete (inactive).\n// The embedded text joins every field so the vector captures problem, symptoms, cause and solution.\n// The payload keeps the full article so the RAG flow can build the prompt from Qdrant alone.\nconst body = $('Webhook').first().json.body || {};\nconst articles = Array.isArray(body.articles) ? body.articles : [];\n\nconst valid = articles.filter(a => Number.isInteger(a.id) && a.id > 0);\nconst invalidCount = articles.length - valid.length;\n\nconst toText = a => [\n  `Título: ${a.title ?? ''}`,\n  `Problema: ${a.problem ?? ''}`,\n  `Síntomas: ${a.symptoms ?? ''}`,\n  `Causa: ${a.cause ?? ''}`,\n  `Solución: ${a.solution ?? ''}`,\n].join('\\n');\n\nconst active = valid\n  .filter(a => a.active === true)\n  .map(a => ({\n    id: a.id,\n    text: toText(a),\n    payload: { article_id: a.id, title: a.title ?? '', problem: a.problem ?? '', symptoms: a.symptoms ?? '', cause: a.cause ?? '', solution: a.solution ?? '' },\n  }));\nconst inactiveIds = valid.filter(a => a.active !== true).map(a => a.id);\n\nreturn [{\n  json: {\n    active,\n    inactiveIds,\n    hasActive: active.length > 0,\n    hasInactive: inactiveIds.length > 0,\n    warnings: invalidCount > 0 ? [`${invalidCount} article(s) skipped: missing or invalid id`] : [],\n  },\n}];"
      }
    },
    {
      "id": "8a1f0c52-1d0e-4c1a-9b11-000000000005",
      "name": "Has active?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.hasActive }}",
              "rightValue": "",
