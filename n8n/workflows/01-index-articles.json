        "url": "={{ $env.OPENROUTER_BASE_URL }}/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENROUTER_EMBEDDING_MODEL, input: $json.active.map(a => a.text) }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "8a1f0c52-1d0e-4c1a-9b11-000000000007",
      "name": "Build points",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pairs each embedding with its article. Point id = article id, so upserts never duplicate.\nconst prepared = $('Prepare articles').first().json;\nconst data = [...($input.first().json.data || [])].sort((a, b) => a.index - b.index);\n\nif (data.length !== prepared.active.length) {\n  throw new Error(`Expected ${prepared.active.length} embeddings, got ${data.length}`);\n}\n\nreturn [{\n  json: {\n    points: prepared.active.map((a, i) => ({ id: a.id, vector: data[i].embedding, payload: a.payload })),\n  },\n}];"
      }
    },
    {
      "id": "8a1f0c52-1d0e-4c1a-9b11-000000000008",
      "name": "Upsert points",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "onError": "continueErrorOutput",
