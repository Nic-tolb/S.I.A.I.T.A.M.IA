    },
    {
      "id": "8a1f0c52-1d0e-4c1a-9b11-000000000006",
      "name": "Create embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 100],
      "onError": "continueErrorOutput",
      "parameters": {
