# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored: NEVER commit real keys.

# --- General ---
TZ=America/Bogota

# --- PostgreSQL ---
POSTGRES_DB=incidents
POSTGRES_USER=incidents
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# Allowed origins for development without nginx (e.g. Live Server)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Frontend (nginx) ---
FRONTEND_PORT=8081

# --- n8n ---
N8N_PORT=5678
# Key used by n8n to encrypt its internal credentials (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change_to_random_value
# Shared secret: Spring Boot sends it in the X-Webhook-Secret header and n8n validates it
N8N_WEBHOOK_SECRET=change_to_random_value
N8N_INDEXING_PATH=/webhook/index-articles
N8N_RAG_PATH=/webhook/rag-assistant
N8N_CONNECT_TIMEOUT=5s
N8N_READ_TIMEOUT=60s

# --- Qdrant ---
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_articles

# --- OpenRouter (used only by n8n) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The embedding model must be the SAME for indexing and querying
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5

# --- RAG (configurable and justified in the report) ---
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=5
